# Firebase configuration (optional).
#
# When ALL THREE of VITE_FIREBASE_API_KEY, VITE_FIREBASE_PROJECT_ID and
# VITE_FIREBASE_APP_ID are set, the app uses Firebase Authentication +
# Firestore. Otherwise it automatically falls back to the local demo
# localStorage mock (no backend required).
#
# Copy this file to `.env` and paste the values from:
#   Firebase Console -> Project settings -> General -> Your apps -> SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Administrator allowlist (comma-separated). Only these emails get the admin
# dashboard. Patients cannot self-register with an admin email.
VITE_ADMIN_EMAILS=admin@swasthya.dev
